{
  "name": "poimen",
  "private": true,
  "version": "0.30.0",
  "description": "Desktop GUI to coordinate AI coding agent sessions",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "oxlint --ignore-pattern \"src/testing/lint-probe/**\" && eslint \"**/*.html\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:changed": "node scripts/check-changed.mjs",
    "ratchets": "node scripts/ratchets/run.mjs",
    "ratchets:test": "node --test scripts/ratchets/core.test.mjs",
    "fixtures:list": "node scripts/fixtures.mjs list",
    "fixtures:shot": "node scripts/fixtures.mjs shot"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@foblex/flow": "19.4.0",
    "@gravionlabs/helix-desktop": "22.6.0",
    "@gravionlabs/helix-ui": "22.6.0",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@xterm/headless": "6.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
