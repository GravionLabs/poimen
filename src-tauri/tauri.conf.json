{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poimen",
  "version": "0.16.0",
  "identifier": "dev.gravionlabs.poimen",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/poimen/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Poimen",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNTk1ODlGMDY1NjcwQkYKUldTL2NGWUduMWhaMElhL0tTK00wQnBhZ3ZDdHJjbUhYcmt0ZlBKSnc5WEtHc1o3cHV1a0F1dWwK",
      "endpoints": [
        "https://github.com/GravionLabs/poimen/releases/latest/download/latest.json"
      ]
    }
  }
}
