// Renovate keeps npm packages (root and site/), Cargo crates (src-tauri) and GitHub Actions current: a few grouped pull
// requests a week against the default branch, gated by CI, merged by a person (no automerge). See AGENTS.md "CI and releases".
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // github>GravionLabs/ci: 7 days minimum release age (security fixes exempt), actions pinned to commit SHAs.
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "github>GravionLabs/ci",
  ],
  // `chore(deps): ...` keeps dependency updates out of the release notes.
  // Issue titles start with their level (AGENTS.md): the dashboard is a PBI.
  dependencyDashboard: true,
  dependencyDashboardTitle: "[PBI] chore: Dependency Dashboard",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  timezone: "Europe/Zurich",
  schedule: ["before 6am on monday"],
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on the first day of the month"] },
  // Raise the range in package.json to the new version instead of leaving it as it was.
  rangeStrategy: "bump",
  automerge: false,
  labels: ["dependencies"],
  enabledManagers: ["npm", "cargo", "github-actions"],
  // The vendored copy of portable-pty is changed by hand (src-tauri/vendor/portable-pty/POIMEN.md).
  ignorePaths: ["src-tauri/vendor/**", "**/node_modules/**", "**/target/**"],
  // A known vulnerability gets a pull request at once, outside the schedule.
  vulnerabilityAlerts: { enabled: true, labels: ["security"], schedule: ["at any time"] },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      // Rust patch and minor updates in one pull request; majors stay separate.
      groupName: "rust",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      groupName: "angular",
      // Angular pins the range of TypeScript it supports: they move together.
      matchPackageNames: ["@angular/**", "@angular-devkit/**", "@schematics/angular", "typescript"],
    },
    {
      // helix-desktop has helix-ui as a peer: they move together, and a helix release is not held back for 7 days.
      groupName: "helix",
      matchPackageNames: ["@gravionlabs/helix-*"],
      minimumReleaseAge: null,
    },
    { groupName: "xterm", matchPackageNames: ["@xterm/**"] },
    { groupName: "codemirror", matchPackageNames: ["@codemirror/**", "@lezer/**"] },
    {
      // The Tauri crates and the npm packages release together.
      groupName: "tauri",
      matchPackageNames: ["tauri", "tauri-*", "@tauri-apps/**"],
    },
    {
      // Packages the repository pins to an exact version (no range in package.json) keep it.
      matchManagers: ["npm"],
      matchPackageNames: [
        "@codemirror/**",
        "@lezer/highlight",
        "@dagrejs/dagre",
        "@foblex/flow",
        "@gravionlabs/helix-ui",
        "@gravionlabs/helix-desktop",
        "@xterm/addon-search",
        "@xterm/addon-unicode11",
        "@xterm/headless",
        "dompurify",
        "marked",
      ],
      rangeStrategy: "pin",
    },
    {
      // Majors get their own pull requests, labelled, and a person decides.
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
  ],
}
